# ==============================================================================
# HealthGuardian AI — Environment Variables Reference (.env.example)
# DO NOT COMMIT REAL SECRETS TO GIT
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Runtime Configuration (Node backend on Render / local)
# ------------------------------------------------------------------------------
# Port for the Node server (Render automatically sets PORT in production)
PORT=3000

# Host binding for the Node server (Render requires 0.0.0.0)
HOST=0.0.0.0

# Node environment: 'production' for live deployment, 'development' for local
NODE_ENV=production

# Optional CORS origin for local cross-origin development (not needed in production single-server)
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. AI Provider API Keys (SERVER-ONLY — Never expose in client bundle)
# HealthGuardian AI uses a 7-provider resilient fallback router + local fallback
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
SAMBANOVA_API_KEY=
COHERE_API_KEY=
CEREBRAS_API_KEY=

# ------------------------------------------------------------------------------
# 3. AI Provider Model Overrides (SERVER-ONLY — Optional)
# ------------------------------------------------------------------------------
OPENROUTER_MODEL=openrouter/free
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
MISTRAL_MODEL=mistral-small-latest
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
COHERE_MODEL=command-r-plus-08-2024
CEREBRAS_MODEL=gpt-oss-120b

# AI Provider router cooldown & timeout tuning (in milliseconds)
PROVIDER_COOLDOWN_MS=60000
PROVIDER_TIMEOUT_MS=20000

# ------------------------------------------------------------------------------
# 4. Client Firebase Configuration (Embedded at build time via Vite)
# These are public client identifiers for Firebase Auth & Firestore
# ------------------------------------------------------------------------------
VITE_API_URL=/api
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Optional backend support email delivery (Resend)
RESEND_API_KEY=
SUPPORT_EMAIL_TO=balajiteen18@gmail.com
SUPPORT_EMAIL_FROM=HealthGuardian Support <onboarding@resend.dev>
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: Firebase App Check reCAPTCHA v3 site key
# VITE_FIREBASE_APPCHECK_SITE_KEY=
